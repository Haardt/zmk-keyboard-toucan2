#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define SYS   3
#define MOUSE 4
#define NUM   5
#define FUN   6

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                6 7 8 9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                39 40 41
            >;

            hold-trigger-on-release;

            display-name = "HRM Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                0 1 2 3 4 5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38
            >;

            hold-trigger-on-release;

            display-name = "HRM Right";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp LCTRL &hml LGUI A &hml LALT S &hml LSHFT D &hml LCTRL F &kp G   &kp H &hmr RCTRL J &hmr RSHFT K &hmr RALT L &hmr RGUI SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                                &mo NUM &mo NAV &kp SPACE   &kp RET &mo SYM &mo FUN
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB   &none    &none     &none      &none     &none   &kp PG_UP &kp HOME &kp UP   &kp END   &kp PG_UP &kp BSPC
                &kp LCTRL &kp LGUI &kp LALT  &kp LSHFT  &kp LCTRL &none   &none &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &kp DEL
                &kp LSHFT &none    &none     &none      &none     &none   &kp PG_DN &none &none    &none     &none     &kp ESC
                                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH   &none &none     &none      &none    &none    &kp BSPC
                &kp SEMI  &kp SQT   &kp COMMA &kp DOT &kp FSLH &none      &none &kp RCTRL &kp RSHFT &kp RALT &kp RGUI &none
                &none     &none     &none     &none    &none    &none      &none &none     &none      &none    &none    &kp ESC
                                         &trans &trans &trans   &trans &trans &trans
            >;
        };

        sys {
            display-name = "SYS";
            bindings = <
                &studio_unlock &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &out OUT_USB &out OUT_BLE &out OUT_TOG &none &none &kp BSPC
                &bt BT_CLR     &none        &none        &none        &none        &none          &none        &none        &none        &none &none &none
                &none          &none        &none        &none        &none        &none          &none        &none        &none        &none &none &kp ESC
                                                      &trans &trans &trans   &trans &trans &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &kp TAB   &none    &none    &none     &none     &none   &kp FSLH &kp N7 &kp N8 &kp N9 &kp MINUS &kp BSPC
                &kp LCTRL &kp LGUI &kp LALT &kp LSHFT &kp LCTRL &none   &kp STAR &kp N4 &kp N5 &kp N6 &kp PLUS  &kp EQUAL
                &kp LSHFT &none    &none    &none     &none     &none   &kp N0   &kp N1 &kp N2 &kp N3 &kp DOT   &kp ESC
                                    &trans &trans &trans   &trans &trans &trans
            >;
        };

        fun {
            display-name = "FUN";
            bindings = <
                &kp F1     &kp F2         &kp F3   &kp F4      &kp F5   &kp F6       &none &none     &none      &none    &none    &kp BSPC
                &kp F7     &kp F8         &kp F9   &kp F10     &kp F11  &kp F12      &none &kp RCTRL &kp RSHFT &kp RALT &kp RGUI &none
                &kp C_PREV &kp C_PLAY_PAUSE &kp C_NEXT &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP   &none &none &none &none &none &kp ESC
                                                   &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
